{
    "name": "ervinsvilumsons/gerbtuve",
    "description": "Gerbtuve WordPress website.",
    "keywords": [
        "ervinsvilumsons",
        "wordpress",
        "gerbtuve"
    ],
    "homepage": "https://www.gerbtuve.com",
    "license": "proprietary",
    "type": "project",
    "authors": [
        {
            "name": "ervinsvilumsons",
            "email": "ervins.vilumsons@gmail.com"
        }
    ],
    "repositories": [
        {
            "name": "wp-packages",
            "type": "composer",
            "url": "https://repo.wp-packages.org"
        },
        {
            "type": "composer",
            "url": "https://wpackagist.org"
        },
        {
            "type": "package",
            "package": {
                "name": "wp-cerber/wp-cerber",
                "version": "9.9.5",
                "type": "wordpress-plugin",
                "dist": {
                    "url": "https://downloads.wpcerber.com/plugin/wp-cerber.zip",
                    "type": "zip"
                }
            }
        }
    ],
    "require": {
        "composer/installers": "^2.2",
        "wp-cerber/wp-cerber": "^9.9",
        "wp-plugin/cloudflare-flexible-ssl": "^1.3",
        "wp-plugin/cookie-law-info": "^3.5",
        "wp-plugin/ewww-image-optimizer": "^8.7",
        "wp-plugin/google-analytics-dashboard-for-wp": "^10.1",
        "wp-plugin/meta-tag-manager": "^3.3",
        "wp-plugin/onesignal-free-web-push-notifications": "^3.9",
        "wp-plugin/post-slider-and-carousel": "^3.5",
        "wp-plugin/really-simple-ssl": "^9.7",
        "wp-plugin/simple-local-avatars": "^2.8",
        "wp-plugin/social-pug": "^1.36",
        "wp-plugin/ultimate-dashboard": "^3.8",
        "wp-plugin/updraftplus": "^1.26",
        "wp-plugin/w3-total-cache": "^2.10",
        "wp-theme/kadence": "^1.5"
    },
    "scripts": {
        "check": [
            "@composer validate --strict",
            "@composer audit"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true
        }
    },
    "extra": {
        "wordpress-install-dir": ".",
        "installer-paths": {
            "wp-content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "wp-content/themes/{$name}/": [
                "type:wordpress-theme"
            ]
        }
    },
    "prefer-stable": true
}
